# =============================================================================
#  MountPad — environment configuration (SQLite flavour)
# -----------------------------------------------------------------------------
#  Single-binary, zero-dependency setup: data lives in a SQLite file alongside
#  the storage mount. Use this when you don't want to run Postgres.
#
#  The "Runtime", "Sessions & auth" and "Storage" sections mirror
#  `.env.example` (the Postgres flavour) and behave the same way.
# =============================================================================


# ── Runtime & branding ───────────────────────────────────────────────────────
MOUNTPAD_ENV=dev
MOUNTPAD_APP_NAME=MountPad
MOUNTPAD_HTTP_ADDR=:4499


# ── Sessions & auth ──────────────────────────────────────────────────────────
MOUNTPAD_SESSION_SECRET=please-change-me-32+-bytes
MOUNTPAD_COOKIE_SECURE=false
MOUNTPAD_SAFE_MODE=false


# ── Database (SQLite) ────────────────────────────────────────────────────────
# Under the bundled docker-compose SQLite setup, the DB file lives inside the
# storage mount at /storage/.mountpad/mountpad.db so it's hidden from the
# file explorer but backed up alongside the rest of the user data.
DB_DRIVER=sqlite
DB_DSN=file:./mountpad.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)


# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_HOST_PATH=./examples/storage
