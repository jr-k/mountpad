# Runtime
MOUNTPAD_APP_NAME=MountPad
MOUNTPAD_PUBLIC_URL=http://localhost:4499
MOUNTPAD_PORT=4499

# Sessions & auth
MOUNTPAD_SESSION_SECRET=please-change-me-32+-bytes
MOUNTPAD_COOKIE_SECURE=false
MOUNTPAD_SAFE_MODE=false

# Storage
STORAGE_HOST_PATH=./storage

# Filesystem
# Follow symlinks inside mount points (default false - safer).
MOUNTPAD_FOLLOW_SYMLINK=false

# Database engine (sqlite | postgres)
DB_ENGINE=sqlite

# SQLite
DB_FILE=/storage/.mountpad/mountpad.db

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=mountpad
DB_PASSWORD=
DB_NAME=mountpad
DB_SSLMODE=disable
