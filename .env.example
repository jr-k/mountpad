# =============================================================================
#  MountPad — environment configuration (PostgreSQL flavour)
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and adjust the values. Every variable below has a
#  sensible default in code; the entries here are the ones you're most likely
#  to tweak per environment (dev / staging / prod).
#
#  The SQLite-only setup lives in `.env.sqlite.example` and shares the
#  "Runtime", "Sessions & auth" and "Storage" sections with this file.
# =============================================================================


# ── Runtime & branding ───────────────────────────────────────────────────────
# What the app calls itself and how it presents itself to the outside world.
MOUNTPAD_ENV=dev
MOUNTPAD_APP_NAME=MountPad
MOUNTPAD_HTTP_ADDR=:4499
MOUNTPAD_PUBLIC_URL=http://localhost:4499


# ── Sessions & auth ──────────────────────────────────────────────────────────
# Cookie + session knobs. `SESSION_SECRET` is mandatory in prod (no default).
# `SAFE_MODE=true` bypasses sign-in to let you recover a locked-out instance:
# log in as the synthetic admin, reset a password, then restart with it off.
MOUNTPAD_SESSION_SECRET=please-change-me-32+-bytes
MOUNTPAD_SESSION_LIFETIME=168h
MOUNTPAD_COOKIE_SECURE=false
MOUNTPAD_SAFE_MODE=false


# ── Database ─────────────────────────────────────────────────────────────────
# Driver picks the embedded SQLite or an external Postgres. `DB_DSN` is the
# raw connection string; the `POSTGRES_*` block is consumed by the bundled
# docker-compose Postgres service (used to interpolate its own env).
DB_DRIVER=postgres
DB_DSN=postgres://mountpad:mountpad@localhost:5432/mountpad?sslmode=disable

POSTGRES_USER=mountpad
POSTGRES_PASSWORD=mountpad
POSTGRES_DB=mountpad


# ── Storage ──────────────────────────────────────────────────────────────────
# Host path bind-mounted into the container at /storage. Mount points are
# configured at runtime in the UI; this is just the root the container can
# reach. Anything outside /storage is invisible to MountPad.
STORAGE_HOST_PATH=./examples/storage


# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Where to find the built assets in prod, and where to proxy to in dev. Set
# `VITE_DEV=true` only when the Vite dev server is actually running.
MOUNTPAD_FRONTEND_DIST=frontend/dist
MOUNTPAD_VITE_DEV=true
MOUNTPAD_VITE_URL=http://localhost:5173


# ── File-explorer behaviour ──────────────────────────────────────────────────
# Per-directory ACLs live in JSON manifests on disk; the explorer can hide
# those files from listings, refuse to follow symlinks out of a mount, and
# cap the size of files opened in the editor (anything bigger is read-only).
MOUNTPAD_MAX_EDIT_BYTES=4194304
MOUNTPAD_MANIFEST_FILENAME=.mountpad.acl.json
MOUNTPAD_SHOW_MANIFESTS=false
MOUNTPAD_ALLOW_SYMLINKS=false
